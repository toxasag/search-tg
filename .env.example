# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public URL is configured in Nginx Proxy Manager; APP_URL documents that deployment URL.
APP_URL="https://tgsearch.team-big.ru"

# NODE_ENV=production enables secure session cookies.
NODE_ENV="production"

# BOOTSTRAP_OWNER_EMAIL / BOOTSTRAP_OWNER_PASSWORD: used only when the database is empty.
# Password must have at least 12 characters. Remove BOOTSTRAP_OWNER_PASSWORD after the first owner starts successfully.
BOOTSTRAP_OWNER_EMAIL="owner@example.com"
BOOTSTRAP_OWNER_PASSWORD="change-this-before-deploying"

# DATABASE_PATH: persistent SQLite location on the VPS. Keep its parent directory backed up and outside Git.
DATABASE_PATH="./data/search-tg.sqlite"

# HTTPS_PROXY: Optional. Set this if your system uses a VPN/proxy that Node.js
# doesn't pick up automatically (Node's fetch ignores the OS-level system proxy
# that browsers use). Find your proxy with `scutil --proxy` (macOS) — combine
# HTTPProxy + HTTPPort, e.g.:
# HTTPS_PROXY="http://127.0.0.1:12334"
